{
  "name": "@ararat-network/signer",
  "version": "0.0.0",
  "private": true,
  "description": "The Ark app's signer: review and signing behind one interface",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./ledger": "./ledger/index.ts",
    "./keystore": "./keystore/index.ts",
    "./keystore/device-check": "./keystore/device-check.ts"
  },
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fixtures:sync": "./scripts/sync-fixtures.sh",
    "fixtures:check": "./scripts/sync-fixtures.sh && ./scripts/check-clean.sh testdata/decoding",
    "secp256k1:sync": "./scripts/sync-secp256k1.sh",
    "secp256k1:check": "./scripts/sync-secp256k1.sh && ./scripts/check-clean.sh keystore/native/secp256k1",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts' 'ledger/*.test.ts' 'keystore/*.test.ts'",
    "test:emulator": "./scripts/fetch-ledger-binaries.sh && node --import tsx --test --test-concurrency=1 'ledger/emulator/*.emu.ts'",
    "test:emulator:record": "RECORD=1 pnpm test:emulator && ./scripts/check-clean.sh testdata/ledger",
    "test:localnet": "./scripts/fetch-ledger-binaries.sh && node --import tsx --test --test-concurrency=1 'e2e/*.e2e.ts'",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@ararat-network/sdk": "0.4.0",
    "@bufbuild/protobuf": "2.17.0",
    "@zondax/ledger-cosmos-js": "4.2.0",
    "@zondax/ledger-js": "2.1.0",
    "buffer": "6.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "26.6.6",
    "@zondax/zemu": "0.69.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
