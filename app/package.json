{
  "name": "@ararat-network/app",
  "version": "0.0.0",
  "private": true,
  "description": "The Ark phone app, for iOS and Android",
  "license": "Apache-2.0",
  "main": "expo-router/entry",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "check:ios": "EXPO_PUBLIC_ARK_DEVICE_CHECK=1 expo run:ios --configuration Release --no-bundler && ./scripts/check-native.sh ios",
    "check:android": "EXPO_PUBLIC_ARK_DEVICE_CHECK=1 ORG_GRADLE_PROJECT_arkKeystoreAllowSoftware=true expo run:android --variant release --no-bundler && ./scripts/check-native.sh android",
    "prebuild": "expo prebuild --clean --no-install",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@ararat-network/signer": "link:../signer",
    "@expo/log-box": "58.0.15",
    "@expo/metro-runtime": "58.0.17",
    "expo": "58.0.26",
    "expo-build-properties": "58.0.12",
    "expo-constants": "58.0.16",
    "expo-linking": "58.0.17",
    "expo-router": "58.0.32",
    "expo-status-bar": "58.0.5",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
