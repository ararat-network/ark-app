{
  "expo": {
    "name": "Ark",
    "slug": "ark",
    "version": "0.0.0",
    "scheme": "ark",
    "orientation": "portrait",
    "ios": {
      "bundleIdentifier": "network.ararat.ark",
      "supportsTablet": false
    },
    "android": {
      "package": "network.ararat.ark"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 28
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
